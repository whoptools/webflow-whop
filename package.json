{
  "name": "whop-commerce",
  "version": "0.1.5",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:extension": "webflow extension serve",
    "build": "node scripts/build.mjs",
    "bundle": "npm run build && webflow extension bundle",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint src server test scripts",
    "start": "tsx server/index.ts",
    "review": "node scripts/review.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@frosted-ui/colors": "0.0.1-canary.164",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/supertest": "^7.2.1",
    "@webflow/designer-extension-typings": "^2.2.2",
    "@webflow/webflow-cli": "^2.17.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.21.0",
    "eslint-plugin-promise": "^7.2.1",
    "frosted-ui": "0.0.1-canary.164",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "supertest": "^7.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "@whop/elements": "^1.10.0",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.23.15",
    "webflow-api": "^3.3.4"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "adm-zip": "^0.6.1",
      "undici": "^7.30.1"
    }
  },
  "private": true,
  "description": "Whop checkout buttons and embedded payments for the Webflow Designer",
